; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppId={{02219AA2-4846-4916-A9EC-699148AD5B08}}
AppName=Synd
AppVersion=2.0
AppPublisher=Chris
DefaultDirName={autopf}\Synd
DefaultGroupName=Synd
OutputDir=Output
OutputBaseFilename=Synd-Setup-2.0
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\synd.exe

[Files]
Source: "dist\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\Synd"; Filename: "{app}\synd.exe"
Name: "{autodesktop}\Synd"; Filename: "{app}\synd.exe"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; Flags: unchecked

[Run]
Filename: "{app}\synd.exe"; Description: "Launch Synd"; Flags: nowait postinstall skipifsilent
